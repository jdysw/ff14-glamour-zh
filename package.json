{
  "name": "ff14-glamour-zh",
  "version": "1.4.5",
  "private": true,
  "description": "FF14 幻化站中文化 · 与灰机 wiki 双向互查（userscript）",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node tests/run.mjs --suite=unit,integration",
    "test:unit": "node tests/run.mjs --suite=unit",
    "test:coverage": "node tools/coverage/run-native-coverage.mjs",
    "test:integration": "node tests/run.mjs --suite=integration",
    "test:live": "node tests/run.mjs --suite=live",
    "test:all": "node tests/run.mjs --suite=all",
    "test:core": "node tests/run.mjs --suite=core",
    "test:bench": "node tests/run.mjs --suite=benchmark",
    "bench:baseline": "node tests/benchmark/bench-lifecycle.mjs --save && node tests/benchmark/bench-read-path.mjs --save",
    "bench:compare": "node tests/benchmark/compare.mjs",
    "check:dist": "node --check dist/ff14-glamour-zh.greasyfork.user.js",
    "validate:data": "node build/python.mjs build/validate-data.py",
    "version:check": "node build/version.mjs --check",
    "version:sync": "node build/version.mjs",
    "check:source": "node build/verify-module-source.mjs",
    "check:deps": "node build/verify-dependencies.mjs",
    "build:miramiru-test": "node build/build.mjs && node build/make-miramiru-test.mjs",
    "build:font-test": "node build/build.mjs && node build/make-font-test.mjs"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "rollup": "^4.64.0"
  }
}
