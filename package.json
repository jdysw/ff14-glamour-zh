{
  "name": "ff14-glamour-zh",
  "version": "1.4.6-beta.1",
  "private": true,
  "description": "FF14 幻化站中文化 · 与灰机 wiki 双向互查（userscript）",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build/userscript/build.mjs",
    "test": "npm run test:e2e",
    "test:e2e": "node tests/run.mjs --suite=e2e",
    "test:unit": "node tests/run.mjs --suite=unit,native",
    "test:contracts": "node tests/run.mjs --suite=contracts",
    "test:coverage": "node tools/coverage/run-native-coverage.mjs",
    "test:integration": "npm run test:e2e",
    "test:e2e-tools": "node tests/run.mjs --suite=e2e-tools",
    "test:live": "node tests/run.mjs --suite=live",
    "test:all": "node tests/run.mjs --suite=all",
    "test:bench": "node tests/run.mjs --suite=benchmark",
    "bench:baseline": "node tests/benchmark/bench-lifecycle.mjs --save && node tests/benchmark/bench-read-path.mjs --save",
    "bench:compare": "node tests/benchmark/compare.mjs",
    "check:dist": "node --check dist/ff14-glamour-zh.greasyfork.user.js",
    "validate:data": "node build/python.mjs build/data/validate-data.py",
    "version:check": "node build/userscript/version.mjs --check",
    "version:sync": "node build/userscript/version.mjs",
    "check:deps": "node build/userscript/verify-dependencies.mjs",
    "build:miramiru-test": "node build/userscript/build.mjs && node build/userscript/make-site-test.mjs miramiru",
    "build:eden-test": "node build/userscript/build.mjs && node build/userscript/make-site-test.mjs eden",
    "build:xivc-test": "node build/userscript/build.mjs && node build/userscript/make-site-test.mjs xivc",
    "build:font-test": "node build/userscript/build.mjs && node build/userscript/make-font-test.mjs",
    "test:build": "node tests/run.mjs --suite=build",
    "test:experimental": "node tests/run.mjs --suite=experimental"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "happy-dom": "^21.0.4",
    "rollup": "^4.64.0"
  }
}
