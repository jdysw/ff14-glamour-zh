# —— 构建产物 ——
# dist/：本地构建产物（build.sh 生成，供测试与手动验证）；发布走 GitHub Releases
dist/

# —— 杂项 ——
*.bak-*
*.tmp
.DS_Store
node_modules/
__pycache__/

# 测试缓存（注入副本/日志/Chrome profile；v1.4 起测试资产在 tests/）
tests/.cache/

# extract_dicts.py 副产物（块位置信息，供临时脚本读取）
dict/_blocks.json

# 数据重建下载缓存（不入库）
build/.cache/

# 数据站部署产物（.github/deploy/prepare.py 生成）
site/
